  "keyFeatures": [
    "Website visitor identification — reveal which companies and individuals visit your site",
    "Lead scoring — auto-scored accounts and contacts based on ICP fit and engagement",
    "Contact enrichment — waterfall enrichment from email or LinkedIn URL",
    "Filter sets — save and reuse rich filter queries across accounts and contacts",
    "Real-time webhooks — get notified on account identified, contact identified, score changed, and play triggered events",
    "Activity feed — full page-visit history per account or contact",
    "Multi-tenant provisioning — create and manage sub-tenants via API",
    "Tracking script — simple `<script>` tag embed for visitor identification"
  ],
  "publicApiSurface": [
    "GET /v1/accounts — list identified accounts",
    "GET /v1/accounts/{account_id} — get account by ID or domain",
    "GET /v1/contacts — list identified contacts",
    "GET /v1/contacts/{contact_id} — get contact by ID",
    "GET /v1/activity — list page-visit activity for an account or contact",
    "GET /v1/scores — get lead scores for an account or contact",
    "GET /v1/scores/recent — list recent score changes across the tenant",
    "GET /v1/filter-sets — list saved filter sets",
    "POST /v1/filter-sets — create a filter set",
    "PUT /v1/filter-sets/{filter_set_id} — update a filter set",
    "DELETE /v1/filter-sets/{filter_set_id} — delete a filter set",
    "POST /v1/webhooks — create a webhook subscription",
    "GET /v1/webhooks — list webhook subscriptions",
    "DELETE /v1/webhooks/{webhook_id} — delete a webhook subscription",
    "POST /v1/enrich — enrich a contact by email",
    "POST /v1/tenants — provision a new tenant",
    "DELETE /v1/tenants/{product_slug} — deactivate a tenant",
    "GET /v1/script — get tracking script embed code",
    "GET /v1/script/status — check tracking script installation status",
    "GET /v1/me — verify API key"
  ]
}
